rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Articles collection: public read access for home page
    match /articles/{articleId} {
      allow read: if true; // Public access for NewsView
      
      // Allow updates to fullContent fields (for client-side caching)
      // This allows the article reader to cache extracted content
      // Only allow updating these specific fields, and only if they're the only changes
      allow update: if 
        // Check that only fullContent fields are being changed
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['fullContent', 'fullContentExtractedAt']) &&
        // Ensure fullContent is a string if present
        (!('fullContent' in request.resource.data) || 
         request.resource.data.fullContent is string) &&
        // Ensure fullContentExtractedAt is a timestamp if present
        (!('fullContentExtractedAt' in request.resource.data) || 
         request.resource.data.fullContentExtractedAt is timestamp);
      
      // Only Firebase Functions can create articles or update other fields
      allow create: if false; // Only Firebase Functions can create
      allow delete: if false; // Only Firebase Functions can delete
    }

    // Sources collection: public read access (for SourcesSidebar), authenticated users can write
    match /sources/{sourceId} {
      allow read: if true; // Public access for SourcesSidebar on NewsView
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Fetch logs collection: authenticated users can read, only functions can write
    match /fetchLogs/{logId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Firebase Functions can write
    }

    // Categories collection (deprecated but keeping for backward compatibility)
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if false; // Only Firebase Functions can write
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
